#
# mod-moa — My Own Azeroth
# Progression stages + opt-in challenges for a personal AzerothCore server.
#

[worldserver]

###################################################################################################
# General
###################################################################################################

# MOA.Enable
#        Description: Enable the module.
#        Default:     1
MOA.Enable = 1

# MOA.StartStage
#        Description: Stage used only when moa_state has no row yet (first start).
#                     After that the current stage is stored in the database and
#                     changed with `.moa stage next` / `.moa stage set N`.
#        Default:     1
MOA.StartStage = 1

# MOA.MaxLevels
#        Description: Level cap per stage, comma separated, index 1 = stage 1.
#                     The number of entries defines how many stages exist.
#                     IMPORTANT: MaxPlayerLevel in worldserver.conf must be >= the
#                     highest value here (normally 80), otherwise the core caps
#                     players before the module allows them to level.
#        Default:     60,60,60,70,70,70,70,80,80,80,80,80
MOA.MaxLevels = 60,60,60,70,70,70,70,80,80,80,80,80

# MOA.Locale
#        Description: Language of server-wide broadcasts (stage opened, boss defeated).
#                     Messages addressed to a single player always follow that
#                     player's client locale, regardless of this setting.
#                     Values: zhCN, enUS, auto (follow DBC.Locale)
#        Default:     zhCN
MOA.Locale = zhCN

# MOA.AnnounceLockedInstance
#        Description: Send a chat message when a player is denied entry to a locked instance.
#        Default:     1
MOA.AnnounceLockedInstance = 1

# MOA.DisableRDF
#        Description: Block the dungeon finder. Random dungeons can roll instances that
#                     are not unlocked yet, which leaves the group stuck on a failed teleport.
#        Default:     1
MOA.DisableRDF = 1

###################################################################################################
# Challenge mode (semi-hardcore + slow XP, one package)
###################################################################################################

# MOA.Challenge.Enable
#        Description: Allow characters to enable the challenge with `.moa challenge on`
#                     at level 1 (death knight: 55 or lower).
#                     The challenge is all-or-nothing and includes:
#                       - semi-hardcore: dying to a creature in the open world destroys
#                         all equipped items and removes all carried gold
#                       - slow XP: experience gain multiplied by MOA.Challenge.XpMultiplier
#                     Rewards (talent points, weapons at 60/70/80) are only granted to
#                     characters that have the full challenge enabled.
#                     Cannot be turned off once enabled.
#        Default:     1
MOA.Challenge.Enable = 1

# MOA.Challenge.XpMultiplier
#        Description: Experience multiplier for challenge characters.
#        Default:     0.5
MOA.Challenge.XpMultiplier = 0.5

# MOA.Challenge.ExcludeDungeon
#        Description: Deaths inside dungeons and raids do not trigger the penalty.
#        Default:     1
MOA.Challenge.ExcludeDungeon = 1

# MOA.Challenge.ExcludeBattleground
#        Description: Deaths inside battlegrounds and arenas do not trigger the penalty.
#                     PvP deaths in the open world never trigger it either (they do not
#                     reach OnPlayerKilledByCreature).
#        Default:     1
MOA.Challenge.ExcludeBattleground = 1
